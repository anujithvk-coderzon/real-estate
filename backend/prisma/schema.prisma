// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ListingType {
  SALE
  RENT
  PG
}

enum PropertyType {
  APARTMENT
  INDEPENDENT_HOUSE
  VILLA
  PLOT
  COMMERCIAL
  OFFICE
  ROOM
}

enum PostedBy {
  OWNER
  BROKER
  BUILDER
  DEALER
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum PropertyStatus {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
}

enum AreaUnit {
  SQFT
  SQM
  CENT
  ACRE
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  RENTED
  EXPIRED
}



model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  avatarUrl String?
  role      UserRole @default(USER)
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("users")
  listings Listing[]
}

model Listing {
  id String @id @default(uuid())
  //basic info
  title String
  description String
  slug      String? @unique
  listingType ListingType
  propertyType PropertyType
  postedBy      PostedBy
  //price
  price         Decimal @db.Decimal(12,2)
  isNegotiable  Boolean @default(false)
  securityDeposit Decimal? @db.Decimal(12,2)
  maintenance     Decimal? @db.Decimal(10,2)
  //area
  areaUnit    AreaUnit
  areaValue   Decimal @db.Decimal(12,2)
  areaSqft    Decimal @db.Decimal(12,2)
  // configuration
  bedrooms  Int?
  bathrooms Int?
  balconies Int?
  furnishing Furnishing?
  floorNumber Int?
  totalFloors Int?
  propertyStatus  PropertyStatus?
  availableFrom   DateTime?
  //location  
  addressLine String
  landmark  String?
  locality  String
  city    String
  district String
  state   String
  pincode String
  latitude Float?
  longitude Float?
  //contact 
  contactName String?
  contactPhone String?
  //status
  status ListingStatus @default(DRAFT)
  expiresAt DateTime?
  //owner details
  ownerId String
  owner User @relation(fields: [ownerId],references: [id],onDelete: Restrict) 
  //
  listingImages ListingImages[]
  amenities     Amenity[]
  listingVideo  ListingVideos?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([city,listingType,status])
  @@index([status,createdAt])
  @@index([price])
  @@index([areaSqft])
  @@index([ownerId])
  @@map("listings")
}

model ListingImages {
  id String @id @default(uuid())
  path String
  position Int @default(0)
  listingId String
  listing  Listing @relation(fields: [listingId],references: [id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([listingId])
  @@map("listing_images")
}

model ListingVideos {
  id String @id @default(uuid())
  videoId String @unique
  listingId String @unique
  listing Listing @relation(fields: [listingId],references: [id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("listing_videos")
}

model Amenity {
  id String @id @default(uuid())
  name String @unique
  category String
  listing Listing[]
  createdAt DateTime @default(now())
  @@map("amenities")
}

