// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ListingType {
  SALE
  RENT
  PG
}

enum PropertyType {
  APARTMENT
  INDEPENDENT_HOUSE
  VILLA
  PLOT
  COMMERCIAL
  OFFICE
  ROOM
}

enum PostedBy {
  OWNER
  BROKER
  BUILDER
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum PropertyStatus {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
}

enum AreaUnit {
  SQFT
  SQM
  CENT
  ACRE
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  RENTED
  EXPIRED
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REVOKED
}

enum ProjectStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

model User {
  id                  String             @id @default(uuid())
  slug                String?            @unique
  name                String
  email               String             @unique
  description         String?
  password            String?
  googleId            String?            @unique
  avatarUrl           String?
  role                UserRole           @default(USER)
  isVerified          Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  listings            Listing[]
  accountType         PostedBy?
  agentReraNumber     String?            @unique
  agentReraState      String?
  agentReraName       String?
  agentReraStatus     VerificationStatus @default(NONE)
  agentReraVerifiedAt DateTime?
  projects            Project[]          @relation("BuiltProjects")
  interest            UserInterest[]
  BuyerChats          Conversation[] @relation("BuyerChats")
  sellerChats         Conversation[] @relation("SellerChats")
  messagesSent        Message[]
  @@map("users")
}

model Project {
  id             String             @id @default(ulid())
  name           String
  description    String?
  slug           String?            @unique
  status         ProjectStatus
  propertyType   PropertyType?
  totalUnits     Int?
  minPrice       Decimal?           @db.Decimal(12, 2)
  maxPrice       Decimal?           @db.Decimal(12, 2)
  startedAt      DateTime?
  handoverAt     DateTime?
  locality       String
  city           String
  district       String
  state          String
  pincode        String
  latitude       Float?
  longitude      Float?
  reraNumber     String?            @unique
  reraState      String?
  reraStatus     VerificationStatus @default(NONE)
  reraVerifiedAt DateTime?
  isReraExempt   Boolean            @default(false)
  exemptReason   String?
  builderId      String
  builder        User               @relation("BuiltProjects", fields: [builderId], references: [id], onDelete: Restrict)
  images         ProjectImages[]
  listings       Listing[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([builderId])
  @@map("projects")
}

model ProjectImages {
  id        String   @id @default(uuid())
  path      String
  position  Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("project_images")
}

model Listing {
  id              String          @id @default(uuid())
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectNameText String?
  projectReraText String?
  builderNameText String?
  title           String
  description     String
  slug            String?         @unique
  listingType     ListingType
  propertyType    PropertyType
  postedBy        PostedBy
  //price
  price           Decimal         @db.Decimal(12, 2)
  isNegotiable    Boolean         @default(false)
  securityDeposit Decimal?        @db.Decimal(12, 2)
  maintenance     Decimal?        @db.Decimal(10, 2)
  //area
  areaUnit        AreaUnit
  areaValue       Decimal         @db.Decimal(12, 2)
  areaSqft        Decimal         @db.Decimal(12, 2)
  // configuration
  bedrooms        Int?
  bathrooms       Int?
  balconies       Int?
  furnishing      Furnishing?
  floorNumber     Int?
  totalFloors     Int?
  propertyStatus  PropertyStatus?
  availableFrom   DateTime?
  //location  
  addressLine     String
  landmark        String?
  locality        String
  city            String
  district        String
  state           String
  pincode         String
  latitude        Float?
  longitude       Float?
  //contact 
  contactName     String?
  contactPhone    String?
  contactPhoneVisibility Boolean? @default(true)
  contactWatsappVisibility Boolean? @default(true)
  contactInappVisibility  Boolean? @default(true)
  //status
  status          ListingStatus   @default(DRAFT)
  expiresAt       DateTime?
  //owner details
  ownerId         String
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  //
  listingImages   ListingImages[]
  amenities       Amenity[]
  listingVideo    ListingVideos?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  interest        UserInterest[]
  conversations  Conversation[]
  @@index([city, listingType, status])
  @@index([status, createdAt])
  @@index([price])
  @@index([areaSqft])
  @@index([ownerId])
  @@index([status, latitude, longitude])
  @@index([projectId])
  @@map("listings")
}

model ListingImages {
  id        String   @id @default(uuid())
  path      String
  position  Int      @default(0)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@map("listing_images")
}

model ListingVideos {
  id        String   @id @default(uuid())
  videoId   String   @unique
  listingId String   @unique
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("listing_videos")
}

model Amenity {
  id        String    @id @default(uuid())
  name      String    @unique
  category  String
  listing   Listing[]
  createdAt DateTime  @default(now())

  @@map("amenities")
}

model UserInterest{
  id String @id @default(uuid())
  userId String 
  listingId String
  user User  @relation(references: [id],fields: [userId],onDelete:Cascade)
  listing Listing @relation(references: [id],fields: [listingId],onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId,listingId])
  @@index([userId])
  @@map("user_interests")
}

model Conversation {
id    String  @id @default(uuid())
listingId String
listing Listing @relation(fields: [listingId],references: [id],onDelete: Cascade)
buyerId String
buyer   User @relation("BuyerChats",fields: [buyerId],references: [id],onDelete: Cascade)
sellerId String
seller  User @relation("SellerChats",fields: [sellerId],references: [id],onDelete: Cascade)
lastMessageAt DateTime @default(now())
lastMessageText String @default("")
buyerUnread Int @default(0)
sellerUnread Int @default(0)
createdAt DateTime @default(now())
messages  Message[]
@@unique([listingId,buyerId])
@@map("conversations")
}

model Message {
id String @id @default(uuid())
conversationId String
conversation Conversation @relation(fields: [conversationId],references: [id],onDelete: Cascade)
senderId String
sender User @relation(fields: [senderId],references: [id],onDelete: Cascade)
body String
createdAt DateTime @default(now())
@@map("messages")
}
